# ClipFoam — environment template
#
# Copy to `.env` (repo root) and fill in what you need.
# Every value below is a safe placeholder: nothing here is a real secret.
# The API reads variables with the `CF_` prefix; the web app uses `API_PROXY_TARGET`.

# ----------------------------------------------------------------- core
CF_APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CF_SECRET_KEY=change-me-generate-a-random-48-byte-value
CF_PUBLIC_APP_URL=http://localhost:3000
CF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CF_ENABLE_SIGNUP=true

# ----------------------------------------------------------------- database
# SQLite is the zero-setup default. Postgres for anything real:
# CF_DATABASE_URL=postgresql+psycopg://clipfoam:clipfoam@localhost:5432/clipfoam
CF_DATABASE_URL=sqlite:///./apps/api/data/clipfoam.db

# ----------------------------------------------------------------- security
CF_COOKIE_SECURE=false          # set true behind HTTPS
CF_CSRF_ENABLED=true
CF_RATE_LIMIT_PER_MINUTE=240
CF_LOGIN_RATE_LIMIT_PER_MINUTE=20
# Optional Redis for distributed rate limiting / queues (in-process fallback otherwise)
# CF_REDIS_URL=redis://localhost:6379/0
# Fernet key used to encrypt OAuth tokens at rest (generate once, never rotate casually)
# CF_TOKEN_ENCRYPTION_KEY=

# ----------------------------------------------------------------- storage
CF_STORAGE_BACKEND=local        # local | s3
CF_LOCAL_STORAGE_PATH=./apps/api/data/media
CF_TEMP_WORK_PATH=./apps/api/data/work
CF_SIGNED_URL_TTL_SECONDS=900
CF_MAX_UPLOAD_MB=512
CF_STORAGE_QUOTA_MB=20000
# S3 / Cloudflare R2 (private bucket; files are served through signed URLs)
CF_S3_BUCKET=
CF_S3_REGION=auto
CF_S3_ENDPOINT_URL=
CF_S3_ACCESS_KEY_ID=
CF_S3_SECRET_ACCESS_KEY=
CF_S3_PREFIX=clipfoam

# ----------------------------------------------------------------- media
CF_MAX_DURATION_SECONDS=10800
CF_FFMPEG_BIN=                  # blank = bundled imageio-ffmpeg binary or PATH
CF_FFPROBE_BIN=                 # blank = auto-detect, PyAV fallback if missing
CF_RENDER_TIMEOUT_SECONDS=900
CF_MIN_FREE_DISK_MB=512

# ----------------------------------------------------------------- transcription
# faster_whisper (local, needs requirements-local-ai.txt) or manual (import SRT/VTT/JSON)
CF_TRANSCRIPTION_PROVIDER=faster_whisper
CF_WHISPER_MODEL=small
CF_WHISPER_DEVICE=auto
CF_WHISPER_COMPUTE_TYPE=int8

# ----------------------------------------------------------------- AI provider
# none = deterministic, clearly-labelled copy generation (no key required)
CF_AI_PROVIDER=none             # none | ollama | openai_compatible
CF_OLLAMA_BASE_URL=http://localhost:11434
CF_OLLAMA_MODEL=llama3.1:8b
CF_AI_BASE_URL=
CF_AI_API_KEY=
CF_AI_MODEL=

# ----------------------------------------------------------------- workers
CF_WORKER_CONCURRENCY=2
CF_JOB_MAX_ATTEMPTS=3
CF_JOB_BACKOFF_SECONDS=15
# Development only: run one worker loop inside the API process (single `uvicorn` command).
CF_ENABLE_INLINE_WORKER=false

# ----------------------------------------------------------------- limits & retention
CF_RETENTION_DAYS=30
CF_USAGE_FREE_TRANSCRIPTION_MINUTES=120
CF_USAGE_FREE_RENDER_MINUTES=60

# ----------------------------------------------------------------- URL import (SSRF-guarded)
CF_ALLOW_URL_IMPORT=true
CF_ALLOW_PRIVATE_IMPORT_NETWORKS=false
CF_IMPORT_MAX_BYTES=536870912
CF_IMPORT_ALLOWED_HOSTS=        # optional comma-separated allowlist

# ----------------------------------------------------------------- social publishing
# Leave false unless you have real OAuth apps configured and want live uploads.
CF_SOCIAL_PUBLISH_ENABLED=false
CF_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
CF_YOUTUBE_CLIENT_ID=
CF_YOUTUBE_CLIENT_SECRET=
CF_MASTODON_CLIENT_ID=
CF_MASTODON_CLIENT_SECRET=
CF_MASTODON_INSTANCE=https://mastodon.social

# ----------------------------------------------------------------- frontend
# Where the Next.js server proxies /api/v1/* (server-side only, never sent to the browser)
API_PROXY_TARGET=http://127.0.0.1:8000
